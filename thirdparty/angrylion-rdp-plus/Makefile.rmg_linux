BUILD_DIR := build/rmg-linux
TARGET := $(BUILD_DIR)/rmg-angrylion-plus.so
INSTALL_DIR := $(PJ64_DIR)

QT_VERSION := Qt6
# qt6-base-dev on ubuntu doesn't properly support pkg-config..
QT_HEADERS := /usr/include/x86_64-linux-gnu/qt6
QT_LIBEXEC := /usr/lib/qt6/libexec/
QT_HEADERS := -I$(QT_HEADERS) -I$(QT_HEADERS)/QtCore -I$(QT_HEADERS)/QtWidgets -I$(QT_HEADERS)/QtGui \
  # $(shell pkg-config --cflags-only-I $(QT_VERSION)Core $(QT_VERSION)Widgets $(QT_VERSION)Gui)

CC := clang-18
CXX := clang++-18
STRIP := llvm-strip-18

MOC := $(QT_LIBEXEC)moc
UIC := $(QT_LIBEXEC)uic

CLANG_FORMAT := clang-format-14
FORMAT_ARGS := -i -style=file
FORMAT_FILES := $(shell find src -type f -name "*.[ch]") $(shell find src -type f -name "*.cpp")

OPTFLAGS := -march=x86-64-v2 -O3 -ffast-math -flto
CFLAGS   := -x c   -fPIC -std=gnu17 -fvisibility=hidden
CXXFLAGS := -x c++ -fPIC -std=c++20 -fvisibility=hidden -fvisibility-inlines-hidden
WARNFLAGS := -Wall -Wextra -Wshadow -Wpointer-arith -Wformat=2 -Wnull-dereference -Woverflow -Wimplicit-fallthrough
# WARNFLAGS += -Weverything -Wno-cast-function-type-strict -Wno-reserved-macro-identifier -Wno-unsafe-buffer-usage
# WARNFLAGS += -Wno-declaration-after-statement -Wno-c++98-compat -Wno-c++98-compat-pedantic -Wno-exit-time-destructors
# WARNFLAGS += -Wno-global-constructors -Wno-date-time -Wno-unused-macros -Wno-sign-conversion -Wno-cast-align -Wno-implicit-int-conversion
WARNFLAGS += -Werror=implicit-int -Werror=implicit-function-declaration -Werror=int-conversion -Werror=incompatible-pointer-types -Werror=return-type
DEFS := -D_CRT_SECURE_NO_WARNINGS -D_CRT_NONSTDC_NO_WARNINGS -DRMG
INCLUDES := -Isrc $(QT_HEADERS) -I$(BUILD_DIR)/src/plugin/mupen64plus/UserInterface
DEPFLAGS = -MMD -MP -MF $(@:.o=.d)

LDFLAGS := -shared $(OPTFLAGS) -static-libgcc -static-libstdc++
LDLIBS := -l$(QT_VERSION)Gui -l$(QT_VERSION)Widgets

CORE_DIRS      := $(shell find src/core -type d -not -path "src/core/n64video*")
CORE_C_FILES   := $(foreach dir, $(CORE_DIRS), $(wildcard $(dir)/*.c))
CORE_CXX_FILES := $(foreach dir, $(CORE_DIRS), $(wildcard $(dir)/*.cpp))
CORE_O_FILES   := $(foreach f, $(CORE_C_FILES), $(BUILD_DIR)/$(f:.c=.o)) \
                  $(foreach f, $(CORE_CXX_FILES), $(BUILD_DIR)/$(f:.cpp=.o))

OUTPUT_DIRS      := $(shell find src/output -type d)
OUTPUT_C_FILES   := $(foreach dir, $(OUTPUT_DIRS), $(wildcard $(dir)/*.c))
OUTPUT_CXX_FILES := $(foreach dir, $(OUTPUT_DIRS), $(wildcard $(dir)/*.cpp))
OUTPUT_O_FILES   := $(foreach f, $(OUTPUT_C_FILES), $(BUILD_DIR)/$(f:.c=.o)) \
                    $(foreach f, $(OUTPUT_CXX_FILES), $(BUILD_DIR)/$(f:.cpp=.o))

M64P_DIRS          := $(shell find src/plugin/mupen64plus -type d)
M64P_C_FILES       := $(foreach dir, $(M64P_DIRS), $(wildcard $(dir)/*.c))
M64P_CXX_FILES     := $(foreach dir, $(M64P_DIRS), $(wildcard $(dir)/*.cpp))
M64P_MOC_HEADERS   := src/plugin/mupen64plus/UserInterface/MainDialog.hpp
M64P_MOC_CPP_FILES := $(foreach f, $(M64P_MOC_HEADERS), $(BUILD_DIR)/$(f:.hpp=.moc.cpp))
M64P_O_FILES       := $(foreach f, $(M64P_C_FILES), $(BUILD_DIR)/$(f:.c=.o)) \
                      $(foreach f, $(M64P_CXX_FILES), $(BUILD_DIR)/$(f:.cpp=.o)) \
					  $(foreach f, $(M64P_MOC_CPP_FILES), $(f:.cpp=.o))

DEP_FILES := $(CORE_O_FILES:.o=.d) $(OUTPUT_O_FILES:.o=.d) $(M64P_O_FILES:.o=.d)

$(shell mkdir -p $(BUILD_DIR) $(foreach dir, $(CORE_DIRS) $(OUTPUT_DIRS) $(M64P_DIRS), $(BUILD_DIR)/$(dir)))

.PHONY: all clean format install

all: $(TARGET)

clean:
	$(RM) -r $(BUILD_DIR)

format:
	$(CLANG_FORMAT) $(FORMAT_ARGS) $(FORMAT_FILES)
# Trim trailing whitespace
	$(foreach f,$(FORMAT_FILES),$(shell sed -i 's/[ \t]*$$//' $f))
# Add missing newlines
	$(foreach f,$(FORMAT_FILES),$(shell [ -n "$$(tail -c1 $f)" ] && printf '\n' >> $f))

install: all
	cp $(TARGET) $(INSTALL_DIR)

# UI generated by UIC
$(BUILD_DIR)/src/plugin/mupen64plus/gfx_m64p.o: $(BUILD_DIR)/src/plugin/mupen64plus/UserInterface/MainDialog.ui.h
$(BUILD_DIR)/src/plugin/mupen64plus/gfxUserInterface/MainDialog.o: $(BUILD_DIR)/src/plugin/mupen64plus/UserInterface/MainDialog.ui.h

$(TARGET): $(CORE_O_FILES) $(OUTPUT_O_FILES) $(M64P_O_FILES)
	$(CXX) $(LDFLAGS) $^ $(LDLIBS) -o $@
	$(STRIP) $@

$(BUILD_DIR)/src/%.o: src/%.c
	$(CC) $(CFLAGS) $(OPTFLAGS) $(INCLUDES) $(DEPFLAGS) $(WARNFLAGS) $(DEFS) -c $< -o $@

$(BUILD_DIR)/src/%.o: src/%.cpp
	$(CC) $(CXXFLAGS) $(OPTFLAGS) $(INCLUDES) $(DEPFLAGS) $(WARNFLAGS) $(DEFS) -c $< -o $@

$(BUILD_DIR)/src/%.o: $(BUILD_DIR)/src/%.cpp
	$(CC) $(CXXFLAGS) $(OPTFLAGS) $(INCLUDES) $(DEPFLAGS) $(WARNFLAGS) $(DEFS) -c $< -o $@

$(BUILD_DIR)/src/%.moc.cpp: src/%.hpp
	$(MOC) $< -o $@

$(BUILD_DIR)/src/%.ui.h: src/%.ui
	$(UIC) $< -o $@

# Dependencies

-include $(DEP_FILES)
