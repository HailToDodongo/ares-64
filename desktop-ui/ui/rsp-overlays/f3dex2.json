{
  "name": "Fast3D (F3DEX2)",
  "banner": "F3DEX2",
  "mode": "displaylist",
  "cpuWaitFunctions": ["osRecvMesg", "osSpTaskYield", "guLook", "osViSwapBuffer"],

  "//": "Display-list microcode: no overlay queue. The command dispatch is found at",
  "//2": "runtime by scanning IMEM for `signature` (consecutive words); the dispatch",
  "//3": "`jr` is at sigPC+dispatchOffset and the loop's cmd-word fetch at sigPC+loopOffset.",
  "//4": "At the dispatch, word0Reg/word1Reg hold the two command words and the opcode is",
  "//5": "word0 >> opcodeShift. Offsets are signed hex.",
  "dispatch": {
    "signature": ["0x00196603", "0x000C5840"],
    "loopOffset": "-0x0C",
    "dispatchOffset": "0x14",
    "word0Reg": 25,
    "word1Reg": 24,
    "opcodeShift": 24
  },

  "//classColors": "Flame-chart colour buckets (0..7 in the RSP overlay palette).",
  "classColors": {
    "misc": 0, "xform": 1, "tri": 2, "flow": 3, "rdp": 4, "sync": 7
  },

